# Fill your own credentials locally. Never publish a completed .env file.
AMAP_KEY=
DASHSCOPE_API_KEY=
FLYAI_API_KEY=
HOST=127.0.0.1
PORT=4173
MODEL_CALLS_PER_IP_HOUR=5
MODEL_CALLS_PER_IP_DAY=5
MAX_MODEL_CALLS_PER_DAY=30
# Required in production: persistent directory outside public/.
MODEL_QUOTA_FILE=
REALTIME_AI_ENABLED=1
# Free hosted demo: Supabase private quota RPC; server secrets only.
MODEL_QUOTA_BACKEND=file
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
QUOTA_HASH_SECRET=

# Persistent limit shared by live hotel, city and nearby queries.
REALTIME_QUERY_ENABLED=1
MAX_LIVE_QUERIES_PER_DAY=100
LIVE_QUERIES_PER_IP_DAY=20
LIVE_QUERIES_PER_IP_HOUR=20
